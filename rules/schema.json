{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CyravellRuleDefinition",
  "type": "object",
  "required": ["rules_version", "rules"],
  "properties": {
    "rules_version": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "event_type", "severity", "action", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "event_type": { "type": "string" },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "action": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}

