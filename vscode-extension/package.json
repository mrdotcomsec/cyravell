{
  "name": "cyravell",
  "displayName": "Cyravell",
  "description": "Local-first security monitoring system for AI coding agents",
  "version": "0.1.0",
  "publisher": "cyravell",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Security",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cyravell-container",
          "title": "Cyravell",
          "icon": "media/cyravell-icon.svg"
        }
      ]
    },
    "views": {
      "cyravell-container": [
        {
          "id": "cyravell.statusView",
          "name": "Cyravell Engine Status",
          "type": "tree"
        },
        {
          "id": "cyravell.eventsView",
          "name": "Security Events",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "cyravell.connect",
        "title": "Cyravell: Connect Engine",
        "icon": "$(plug)"
      },
      {
        "command": "cyravell.disconnect",
        "title": "Cyravell: Disconnect Engine",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cyravell.refreshStatus",
        "title": "Cyravell: Refresh Status",
        "icon": "$(refresh)"
      },
      {
        "command": "cyravell.verifyAudit",
        "title": "Cyravell: Verify Audit Chain",
        "icon": "$(shield)"
      },
      {
        "command": "cyravell.inspectEvent",
        "title": "Cyravell: Inspect Security Event",
        "icon": "$(info)"
      },
      {
        "command": "cyravell.openControlledTerminal",
        "title": "Cyravell: Open Protected Controlled Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "cyravell.reviewApprovals",
        "title": "Cyravell: Review Pending Command Approvals",
        "icon": "$(checklist)"
      },
      {
        "command": "cyravell.createBaseline",
        "title": "Cyravell: Create Dependency Baseline",
        "icon": "$(package)"
      },
      {
        "command": "cyravell.reconcileDrift",
        "title": "Cyravell: Check Dependency Drift",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cyravell.reviewApprovals",
          "when": "view == cyravell.statusView",
          "group": "navigation"
        },
        {
          "command": "cyravell.openControlledTerminal",
          "when": "view == cyravell.statusView",
          "group": "navigation"
        },
        {
          "command": "cyravell.refreshStatus",
          "when": "view == cyravell.statusView",
          "group": "navigation"
        },
        {
          "command": "cyravell.connect",
          "when": "view == cyravell.statusView",
          "group": "navigation"
        },
        {
          "command": "cyravell.disconnect",
          "when": "view == cyravell.statusView",
          "group": "navigation"
        },
        {
          "command": "cyravell.refreshStatus",
          "when": "view == cyravell.eventsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "cyravell.inspectEvent",
          "when": "view == cyravell.eventsView",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Cyravell",
      "properties": {
        "cyravell.socketPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Cyravell engine Unix domain socket (leaves blank for auto-discovery)."
        },
        "cyravell.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to Cyravell security engine on startup."
        },
        "cyravell.controlledTerminal.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Cyravell controlled terminal session with active pre-execution interception gate."
        },
        "cyravell.controlledTerminal.engineBinary": {
          "type": "string",
          "default": "cyravell-engine",
          "description": "Path to the cyravell-engine binary used to launch the controlled terminal."
        },
        "cyravell.controlledTerminal.failClosed": {
          "type": "boolean",
          "default": true,
          "description": "Fail closed and prevent command dispatch when the security engine daemon is offline."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "./node_modules/.bin/tsc -p ./",
    "watch": "./node_modules/.bin/tsc -watch -p ./",
    "test": "node ./test/client.test.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.3"
  }
}
